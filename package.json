{
  "name": "games",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "node scripts/check-assets.mjs && node scripts/check-versions.mjs && node --test scripts/next-version.test.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "turbo": "2.11.11",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "apps/*",
    "packages/*",
    "games/*"
  ]
}
